<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main class="container">

        <div class="card">

            <h1><%= title %></h1>

            <p class="description">
                <%= description %>
            </p>

            <div class="status">
                <span class="indicator"></span>
                <%= status %>
            </div>

            <h2>DevSecOps Learning Project</h2>

            <p>
                SecureTask is a task management application
                built to demonstrate secure software delivery.
            </p>

            <div class="features">
                <div>Application Security</div>
                <div>Automated Testing</div>
                <div>CI/CD Automation</div>
                <div>Cloud Deployment</div>
            </div>

        </div>

    </main>

</body>
</html>